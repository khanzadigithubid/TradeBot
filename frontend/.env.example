# Frontend Environment Variables
# Copy this file to .env.local for local development
# For Vercel: set these in Project Settings → Environment Variables

# Local development
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws

# Production (Render backend)
# VITE_API_URL=https://tradebot-omuy.onrender.com/api
# VITE_WS_URL=wss://tradebot-omuy.onrender.com/ws

# Must match the backend's API_SECRET. Sent as the X-API-Secret header on
# /api/bot/*, /api/settings and /api/trades/manual. When the backend has no
# API_SECRET set, those endpoints answer 503 and the dashboard shows a
# read-only banner.
#
# This is a shared secret, not authentication: VITE_* values are inlined into
# the public JS bundle, so anyone can read it in devtools. It stops drive-by
# abuse of a public URL. For real money, keep the control plane private.
# VITE_API_SECRET=
