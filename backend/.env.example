# ── Binance API Keys ──────────────────────────────────────────────────────────
# Get from: https://www.binance.com/en/my/settings/api-management
# For testing use: https://testnet.binance.vision
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
TESTNET=True

# ── Telegram Notifications (Optional) ────────────────────────────────────────
# Create bot: https://t.me/BotFather
# Get Chat ID: https://t.me/userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Gmail Notifications (Optional) ───────────────────────────────────────────
# Use Gmail App Password (NOT your regular password)
# Enable: https://myaccount.google.com/apppasswords
EMAIL_SENDER=yourbot@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_RECEIVER=you@gmail.com
