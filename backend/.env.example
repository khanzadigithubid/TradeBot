# ── Binance API Keys ──────────────────────────────────────────────────────────
# Get from: https://www.binance.com/en/my/settings/api-management
# For testing use: https://testnet.binance.vision
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
TESTNET=True

# ── Telegram Notifications (Optional) ────────────────────────────────────────
# Create bot: https://t.me/BotFather
# Get Chat ID: https://t.me/userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Gmail Notifications (Optional) ───────────────────────────────────────────
# Use Gmail App Password (NOT your regular password)
# Enable: https://myaccount.google.com/apppasswords
EMAIL_SENDER=yourbot@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_RECEIVER=you@gmail.com

# ── Deployment safety ─────────────────────────────────────────────────────────
# API_SECRET
#   Shared secret required by the endpoints that move money or change config
#   (POST /api/bot/*, /api/settings, /api/trades/manual, DELETE /api/trades/{id}).
#   Unset means those endpoints return 503 and the deployment is read-only.
#   Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#   The frontend needs the same value as VITE_API_SECRET. Note that a VITE_*
#   value is inlined into the public JS bundle, so this stops drive-by abuse,
#   not a determined attacker — keep the control plane private for real money.
API_SECRET=

# ALLOW_UNAUTHENTICATED_CONTROL
#   Local development only. Reopens the control endpoints with no secret.
#   Never set this on a host reachable from the internet.
ALLOW_UNAUTHENTICATED_CONTROL=false

# AUTO_START
#   Resume trading when the server boots. Off by default, so deploys and
#   restarts no longer silently start trading. Ignored in live mode: real
#   money must be armed from the UI or API on purpose.
AUTO_START=false

# LIVE_TRADING_ENABLED
#   Required to send real Binance orders. Unset means the bot stays on testnet
#   no matter what the settings file or UI says.
LIVE_TRADING_ENABLED=false

# PAPER_TRADING
#   true simulates orders locally with no exchange calls. Testnet (the default
#   when TESTNET=True) places REAL orders on Binance's testnet venue.
PAPER_TRADING=false

# ── Strategy toggles (Optional) ───────────────────────────────────────────────
# Multi-timeframe confirmation and the sentiment filter. Both default to on in
# config.py; set false to trade on the base signal alone.
MTF_ENABLED=true
SENTIMENT_FILTER=true

# ── Risk control (Optional) ───────────────────────────────────────────────────
# Daily loss limit as a percent of the balance captured at first check of the
# day. When the balance cannot be read the check is skipped rather than
# silently treated as passing, so a blocked host loses the limit entirely.
DAILY_LOSS_LIMIT_PERCENT=5.0

# ── Resend email fallback (Optional) ──────────────────────────────────────────
# Used automatically when the Gmail SMTP path fails, which it does on hosts
# that block outbound SMTP.
RESEND_API_KEY=

# ── Discord notifications (Optional) ──────────────────────────────────────────
DISCORD_WEBHOOK_URL=

# ── Twilio SMS (Optional) ─────────────────────────────────────────────────────
# Present in config and passed through to the engine, but no notifier consumes
# it yet, so setting these has no effect today.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
